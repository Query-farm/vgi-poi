# name: test/sql/detect_write.test
# group: [vgi_poi]
#
# detect_excel scalar + write_xlsx -> read_excel round trip.

require-env VGI_POI_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'excel' AS excel (TYPE vgi, LOCATION '${VGI_POI_WORKER}');

# ---- detect_excel -----------------------------------------------------------

query I
SELECT excel.detect_excel((SELECT content FROM read_blob('test/sql/data/sample.xlsx')));
----
xlsx

query I
SELECT excel.detect_excel((SELECT content FROM read_blob('test/sql/data/sample.xls')));
----
xls

# garbage -> NULL.
query I
SELECT excel.detect_excel((SELECT content FROM read_blob('test/sql/data/garbage.bin')));
----
NULL

# ---- write_xlsx produces a non-empty BLOB -----------------------------------

query I
SELECT octet_length(xlsx) > 0
FROM excel.write_xlsx((SELECT * FROM (VALUES ('alice', 9.5), ('bob', 7.0)) AS t(name, score)));
----
true

# detect_excel recognises what write_xlsx produced.
query I
SELECT excel.detect_excel(
  (SELECT xlsx FROM excel.write_xlsx(
    (SELECT * FROM (VALUES ('alice', 9.5)) AS t(name, score))))
);
----
xlsx

# ---- write_xlsx -> detect_excel round trip ----------------------------------
# NOTE: the VGI read_excel table function only accepts a LITERAL document arg
# (DuckDB forbids subqueries / lateral column params in a table-function arg), so
# a SQL-level write->read cell round trip isn't expressible here. The byte-level
# round trip (write_xlsx bytes re-read with POI) is covered by the JUnit suite.
# Here we assert write_xlsx emits a valid workbook by detecting its format, and
# that a header-on book carries the column names as the first row's bytes.

statement ok
CREATE TEMP TABLE book AS
  SELECT xlsx FROM excel.write_xlsx(
    (SELECT * FROM (VALUES ('alice', 9.5), ('bob', 7.0)) AS t(name, score)),
    header := true);

# Exactly one BLOB row, a non-empty valid .xlsx that detect_excel recognises.
query II
SELECT count(*), bool_and(excel.detect_excel(xlsx) = 'xlsx') FROM book;
----
1	true

statement ok
DETACH excel;
